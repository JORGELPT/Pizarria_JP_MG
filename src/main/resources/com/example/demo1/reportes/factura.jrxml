<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Factura_Pedido" language="java"
              pageWidth="612" pageHeight="792"
              columnWidth="572" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <style name="Row" isDefault="false" mode="Transparent" fontName="Arial" fontSize="9">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#E8F0FB"/>
        </conditionalStyle>
    </style>

    <!-- ═══ PARÁMETROS ═══ -->
    <parameter name="ID_PEDIDO"   class="java.lang.Integer">
        <defaultValueExpression><![CDATA[1]]></defaultValueExpression>
    </parameter>
    <parameter name="LOGO_PATH"   class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="P_CLIENTE"   class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_CEDULA"    class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_TEL"       class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_FECHA"     class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_EMPLEADO"  class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_ENTREGA"   class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_PAGO"      class="java.lang.String">
        <defaultValueExpression><![CDATA["—"]]></defaultValueExpression>
    </parameter>
    <parameter name="P_DIRECCION" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <!-- precio_total guardado en tbl_pedido al momento de la venta — siempre correcto -->
    <parameter name="P_TOTAL" class="java.lang.Double">
        <defaultValueExpression><![CDATA[0.0]]></defaultValueExpression>
    </parameter>

    <!-- ═══ QUERY ═══
         precio_unitario se guarda en tbl_producto_pedido al momento de la venta,
         por lo que siempre refleja el precio real cobrado (incluyendo fallbacks de Java).
    -->
    <queryString><![CDATA[
        SELECT pro.nombre                                      AS descripcion,
               pp.cantidad_producto                           AS cantidad,
               pp.precio_unitario                             AS precio_unitario,
               pp.cantidad_producto * pp.precio_unitario      AS total_linea,
               pp.especificaciones                            AS nota
        FROM   tbl_producto_pedido pp
        JOIN   tbl_producto pro ON pro.id_producto = pp.id_producto
        WHERE  pp.id_pedido = $P{ID_PEDIDO}
        ORDER BY pro.nombre
    ]]></queryString>

    <field name="descripcion"     class="java.lang.String"/>
    <field name="cantidad"        class="java.lang.Integer"/>
    <field name="precio_unitario" class="java.lang.Double"/>
    <field name="total_linea"     class="java.lang.Double"/>
    <field name="nota"            class="java.lang.String"/>

    <variable name="V_SUBTOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{total_linea}]]></variableExpression>
        <initialValueExpression><![CDATA[0.0]]></initialValueExpression>
    </variable>

    <!-- ═══ TÍTULO ═══ -->
    <title>
        <band height="210" splitType="Stretch">

            <!-- Barra azul superior -->
            <rectangle>
                <reportElement x="0" y="0" width="572" height="70"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <!-- Logo Domino's (imagen interna) -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="490" y="3" width="70" height="58"/>
                <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader()
                    .getResourceAsStream("com/example/demo1/imagenes/p1.png")]]></imageExpression>
            </image>

            <!-- Título FACTURA -->
            <staticText>
                <reportElement x="10" y="8" width="220" height="54" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="36" isBold="true"/>
                </textElement>
                <text><![CDATA[FACTURA]]></text>
            </staticText>

            <!-- Empresa -->
            <staticText>
                <reportElement x="220" y="8" width="260" height="22" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[DOMINO'S PIZZA]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="32" width="260" height="14" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="9"/>
                </textElement>
                <text><![CDATA[Sistema de Gestión  |  República Dominicana]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="48" width="260" height="14" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <text><![CDATA[Tel: (809) 000-0000  |  info@dominospizza.do]]></text>
            </staticText>

            <!-- ── Columna izquierda: datos del cliente ── -->

            <!-- Factura Nº -->
            <staticText>
                <reportElement x="0" y="80" width="80" height="14" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Factura Nº:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="80" width="180" height="14"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["#" + $P{ID_PEDIDO}]]></textFieldExpression>
            </textField>

            <!-- Cliente -->
            <staticText>
                <reportElement x="0" y="96" width="80" height="14" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Cliente:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="96" width="230" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_CLIENTE}]]></textFieldExpression>
            </textField>

            <!-- Cédula -->
            <staticText>
                <reportElement x="0" y="112" width="80" height="14" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Cédula:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="112" width="230" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_CEDULA}]]></textFieldExpression>
            </textField>

            <!-- Teléfono -->
            <staticText>
                <reportElement x="0" y="128" width="80" height="14" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Teléfono:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="128" width="230" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TEL}]]></textFieldExpression>
            </textField>

            <!-- Tipo de Entrega -->
            <staticText>
                <reportElement x="0" y="144" width="80" height="14" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Entrega:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="144" width="230" height="14"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_ENTREGA}]]></textFieldExpression>
            </textField>

            <!-- Dirección (solo si hay delivery) -->
            <staticText>
                <reportElement x="0" y="160" width="80" height="14" forecolor="#004AAD">
                    <printWhenExpression><![CDATA[$P{P_DIRECCION} != null && !$P{P_DIRECCION}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Dirección:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="82" y="160" width="230" height="14">
                    <printWhenExpression><![CDATA[$P{P_DIRECCION} != null && !$P{P_DIRECCION}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_DIRECCION}]]></textFieldExpression>
            </textField>

            <!-- ── Columna derecha: datos del pedido ── -->

            <!-- Fecha -->
            <staticText>
                <reportElement x="330" y="80" width="90" height="14" forecolor="#004AAD"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="424" y="80" width="148" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_FECHA}]]></textFieldExpression>
            </textField>

            <!-- Atendido por -->
            <staticText>
                <reportElement x="330" y="96" width="90" height="14" forecolor="#004AAD"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Atendido por:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="424" y="96" width="148" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_EMPLEADO}]]></textFieldExpression>
            </textField>

            <!-- Método de Pago -->
            <staticText>
                <reportElement x="330" y="112" width="90" height="14" forecolor="#004AAD"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Método de pago:]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="424" y="112" width="148" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{P_PAGO}]]></textFieldExpression>
            </textField>

            <!-- Línea separadora -->
            <line>
                <reportElement x="0" y="208" width="572" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>

        </band>
    </title>

    <pageHeader><band height="5"/></pageHeader>

    <!-- ═══ ENCABEZADO DE COLUMNAS ═══ -->
    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="572" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="3" width="240" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Descripción]]></text>
            </staticText>
            <staticText>
                <reportElement x="246" y="3" width="56" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Cant.]]></text>
            </staticText>
            <staticText>
                <reportElement x="304" y="3" width="120" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Precio Unit.]]></text>
            </staticText>
            <staticText>
                <reportElement x="426" y="3" width="142" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Línea]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ═══ DETALLE ═══ -->
    <detail>
        <band height="28" splitType="Stretch">
            <frame>
                <reportElement x="0" y="0" width="572" height="14" style="Row"/>
                <textField isBlankWhenNull="true">
                    <reportElement x="4" y="2" width="240" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="246" y="2" width="56" height="11"/>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" pattern="RD$ #,##0.00">
                    <reportElement x="304" y="2" width="120" height="11"/>
                    <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{precio_unitario}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" pattern="RD$ #,##0.00">
                    <reportElement x="426" y="2" width="142" height="11"/>
                    <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{total_linea}]]></textFieldExpression>
                </textField>
            </frame>
            <!-- Nota del ítem (extras, especificaciones) — y=14, height=11, bottom=25 ≤ 28 ✅ -->
            <textField isBlankWhenNull="true">
                <reportElement x="10" y="14" width="560" height="11" forecolor="#888888">
                    <printWhenExpression><![CDATA[$F{nota} != null && !$F{nota}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <textFieldExpression><![CDATA["  ↳ " + $F{nota}]]></textFieldExpression>
            </textField>
            <!-- Línea separadora — y=27, bottom=28 ✅ -->
            <line>
                <reportElement x="0" y="27" width="572" height="1"
                               forecolor="#CCCCCC" positionType="FixRelativeToBottom"/>
                <graphicElement><pen lineWidth="0.3"/></graphicElement>
            </line>
        </band>
    </detail>

    <columnFooter>
        <band height="6" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="572" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
        </band>
    </columnFooter>

    <!-- ═══ PIE DE PÁGINA ═══ -->
    <pageFooter>
        <band height="22" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="572" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="4" y="2" width="160" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="166" y="2" width="240" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[DOMINO'S PIZZA — ¡Gracias por su preferencia!]]></text>
            </staticText>
            <textField>
                <reportElement x="408" y="2" width="80" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="490" y="2" width="78" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ═══ RESUMEN — Totales ═══ -->
    <summary>
        <band height="90" splitType="Stretch">
            <rectangle>
                <reportElement x="330" y="4" width="242" height="82"
                               forecolor="#E8F0FB" backcolor="#E8F0FB" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <!-- Subtotal = precio_total / 1.18  (guardado en tbl_pedido, siempre exacto) -->
            <staticText>
                <reportElement x="334" y="10" width="110" height="14" forecolor="#004AAD"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement>
                <text><![CDATA[Subtotal:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="RD$ #,##0.00">
                <reportElement x="446" y="10" width="122" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TOTAL} / 1.18]]></textFieldExpression>
            </textField>

            <!-- ITBIS = precio_total - precio_total/1.18 -->
            <staticText>
                <reportElement x="334" y="28" width="110" height="14" forecolor="#004AAD"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10" isBold="true"/></textElement>
                <text><![CDATA[ITBIS (18%):]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="RD$ #,##0.00">
                <reportElement x="446" y="28" width="122" height="14"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{P_TOTAL} - ($P{P_TOTAL} / 1.18)]]></textFieldExpression>
            </textField>

            <!-- Línea divisora -->
            <line>
                <reportElement x="334" y="46" width="234" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>

            <!-- TOTAL = precio_total guardado (con ITBIS incluido) -->
            <staticText>
                <reportElement x="334" y="50" width="110" height="24" forecolor="#BE1E1E"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>
            <textField isBlankWhenNull="true" pattern="RD$ #,##0.00">
                <reportElement x="446" y="50" width="122" height="24" forecolor="#BE1E1E"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{P_TOTAL}]]></textFieldExpression>
            </textField>

            <!-- Nota de pago -->
            <staticText>
                <reportElement x="0" y="10" width="320" height="14" forecolor="#555555"/>
                <textElement><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <text><![CDATA[* Precios en Pesos Dominicanos (RD$). ITBIS incluido.]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="26" width="320" height="14" forecolor="#555555"/>
                <textElement><font fontName="Arial" size="8" isItalic="true"/></textElement>
                <text><![CDATA[* Este documento sirve como comprobante de compra.]]></text>
            </staticText>
        </band>
    </summary>

</jasperReport>
