<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Reporte_ComprasVentas" language="java"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <!-- Rojo para COMPRA (egreso), verde para VENTA (ingreso) -->
    <style name="Row" isDefault="false" mode="Transparent" fontName="Arial" fontSize="9">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{tipo}.equals("COMPRA")]]></conditionExpression>
            <style mode="Opaque" backcolor="#FFE4E4"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{tipo}.equals("VENTA")]]></conditionExpression>
            <style mode="Opaque" backcolor="#E8F5E9"/>
        </conditionalStyle>
    </style>

    <queryString><![CDATA[
        SELECT 'COMPRA' AS tipo,
               p.nombre_proveedor                          AS contraparte,
               ISNULL(CONVERT(varchar, c.fecha, 23), '—') AS fecha,
               ISNULL(c.monto, 0)                         AS monto,
               ISNULL(c.estado, '—')                      AS estado
        FROM tbl_compra c
        INNER JOIN tbl_proveedor p ON c.id_proveedor = p.id_proveedor

        UNION ALL

        SELECT 'VENTA' AS tipo,
               per.nombre                                          AS contraparte,
               ISNULL(CONVERT(varchar, ped.fecha_pedido, 23), '—') AS fecha,
               ISNULL(ped.precio_total, 0)                         AS monto,
               'Completado'                                         AS estado
        FROM tbl_pedido ped
        JOIN tbl_cliente cl  ON ped.id_cliente = cl.id_cliente
        JOIN tbl_persona per ON cl.id_persona  = per.id_persona

        ORDER BY fecha DESC
    ]]></queryString>

    <field name="tipo"        class="java.lang.String"/>
    <field name="contraparte" class="java.lang.String"/>
    <field name="fecha"       class="java.lang.String"/>
    <field name="monto"       class="java.math.BigDecimal"/>
    <field name="estado"      class="java.lang.String"/>

    <variable name="totalCompras" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{tipo}.equals("COMPRA") ? 1 : 0]]></variableExpression>
    </variable>
    <variable name="totalVentas" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{tipo}.equals("VENTA") ? 1 : 0]]></variableExpression>
    </variable>
    <variable name="sumaCompras" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{tipo}.equals("COMPRA") ? $F{monto} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>
    <variable name="sumaVentas" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{tipo}.equals("VENTA") ? $F{monto} : java.math.BigDecimal.ZERO]]></variableExpression>
    </variable>

    <title>
        <band height="110" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="65"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="8" width="480" height="50" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="22" isBold="true"/></textElement>
                <text><![CDATA[REPORTE COMPRAS Y VENTAS]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="8" width="298" height="18" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[DOMINO'S PIZZA | Sistema de Gestión]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="30" width="298" height="14" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <text><![CDATA[República Dominicana]]></text>
            </staticText>
            <textField pattern="'Generado el' dd/MM/yyyy 'a las' HH:mm">
                <reportElement x="0" y="74" width="802" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <!-- Leyenda de colores -->
            <rectangle>
                <reportElement x="0" y="90" width="12" height="10"
                               forecolor="#FFE4E4" backcolor="#FFE4E4" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="14" y="90" width="80" height="10" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="7"/></textElement>
                <text><![CDATA[COMPRA (egreso)]]></text>
            </staticText>
            <rectangle>
                <reportElement x="100" y="90" width="12" height="10"
                               forecolor="#E8F5E9" backcolor="#E8F5E9" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="114" y="90" width="80" height="10" forecolor="#155724"/>
                <textElement><font fontName="Arial" size="7"/></textElement>
                <text><![CDATA[VENTA (ingreso)]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="107" width="802" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
        
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="490" y="3" width="70" height="58"/>
                <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("com/example/demo1/imagenes/p1.png")]]></imageExpression>
            </image></band>
    </title>

    <pageHeader><band height="5"/></pageHeader>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="3" width="70" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement x="76" y="3" width="290" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Proveedor / Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement x="368" y="3" width="100" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="3" width="160" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Monto (RD$)]]></text>
            </staticText>
            <staticText>
                <reportElement x="632" y="3" width="166" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <frame>
                <reportElement x="0" y="0" width="802" height="15" style="Row"/>
                <textField isBlankWhenNull="true">
                    <reportElement x="4" y="2" width="70" height="11"/>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                    <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="76" y="2" width="290" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{contraparte}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="368" y="2" width="100" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" pattern="#,##0.00">
                    <reportElement x="470" y="2" width="160" height="11"/>
                    <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="632" y="2" width="166" height="11"/>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
                </textField>
            </frame>
            <line>
                <reportElement x="0" y="15" width="802" height="1"
                               forecolor="#CCCCCC" positionType="FixRelativeToBottom"/>
                <graphicElement><pen lineWidth="0.3"/></graphicElement>
            </line>
        </band>
    </detail>

    <columnFooter>
        <band height="6" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="802" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="22" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="4" y="2" width="200" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="206" y="2" width="390" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[DOMINO'S PIZZA — Sistema de Gestión]]></text>
            </staticText>
            <textField>
                <reportElement x="598" y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="700" y="2" width="98" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="44" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="4" width="802" height="36"
                               forecolor="#E8F0FB" backcolor="#E8F0FB" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Compras -->
            <staticText>
                <reportElement x="4" y="8" width="90" height="12" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total compras:]]></text>
            </staticText>
            <textField>
                <reportElement x="96" y="8" width="40" height="12" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalCompras}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="4" y="24" width="90" height="12" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Monto compras:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="96" y="24" width="120" height="12" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{sumaCompras}]]></textFieldExpression>
            </textField>
            <!-- Ventas -->
            <staticText>
                <reportElement x="240" y="8" width="90" height="12" forecolor="#155724"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total ventas:]]></text>
            </staticText>
            <textField>
                <reportElement x="332" y="8" width="40" height="12" forecolor="#155724"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalVentas}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="240" y="24" width="90" height="12" forecolor="#155724"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Monto ventas:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="332" y="24" width="120" height="12" forecolor="#155724"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{sumaVentas}]]></textFieldExpression>
            </textField>
            <!-- Balance neto -->
            <staticText>
                <reportElement x="500" y="8" width="100" height="12" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Balance neto:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="602" y="8" width="196" height="12" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{sumaVentas}.subtract($V{sumaCompras})]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
