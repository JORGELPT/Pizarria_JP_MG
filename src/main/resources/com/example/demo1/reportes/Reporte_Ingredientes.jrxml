<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Reporte_Ingredientes" language="java"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <style name="Row" isDefault="false" mode="Transparent" fontName="Arial" fontSize="9">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{cantidad_stock} < $F{cantidad_minima_stock}]]></conditionExpression>
            <style mode="Opaque" backcolor="#FFE4E4"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{cantidad_stock} >= $F{cantidad_minima_stock} &amp;&amp; $F{cantidad_stock} < $F{cantidad_minima_stock} * 1.5 &amp;&amp; $V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#FFF8E1"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{cantidad_stock} >= $F{cantidad_minima_stock} * 1.5 &amp;&amp; $V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#E8F0FB"/>
        </conditionalStyle>
    </style>

    <queryString><![CDATA[
        SELECT i.nombre, i.tipo_ingrediente, i.cantidad_stock,
               i.cantidad_minima_stock, i.fecha_caducidad,
               ISNULL(p.nombre_proveedor, '—') AS proveedor
        FROM tbl_ingrediente i
        LEFT JOIN tbl_proveedor p ON i.id_proveedor = p.id_proveedor
        ORDER BY i.nombre
    ]]></queryString>

    <field name="nombre"                class="java.lang.String"/>
    <field name="tipo_ingrediente"      class="java.lang.String"/>
    <field name="cantidad_stock"        class="java.lang.Integer"/>
    <field name="cantidad_minima_stock" class="java.lang.Integer"/>
    <field name="fecha_caducidad"       class="java.sql.Date"/>
    <field name="proveedor"             class="java.lang.String"/>

    <variable name="totalIngredientes" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{nombre}]]></variableExpression>
    </variable>

    <title>
        <band height="100" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="65"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="8" width="480" height="50" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="24" isBold="true"/></textElement>
                <text><![CDATA[REPORTE DE INGREDIENTES]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="8" width="298" height="18" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement>
                <text><![CDATA[DOMINO'S PIZZA | Sistema de Gestión]]></text>
            </staticText>
            <staticText>
                <reportElement x="500" y="30" width="298" height="14" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <text><![CDATA[República Dominicana]]></text>
            </staticText>
            <textField pattern="'Generado el' dd/MM/yyyy 'a las' HH:mm">
                <reportElement x="0" y="74" width="802" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="97" width="802" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.5"/></graphicElement>
            </line>
        
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="490" y="3" width="70" height="58"/>
                <imageExpression><![CDATA[Thread.currentThread().getContextClassLoader().getResourceAsStream("com/example/demo1/imagenes/p1.png")]]></imageExpression>
            </image></band>
    </title>

    <pageHeader><band height="5"/></pageHeader>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="3" width="161" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Ingrediente]]></text>
            </staticText>
            <staticText>
                <reportElement x="167" y="3" width="81" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="3" width="61" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Stock]]></text>
            </staticText>
            <staticText>
                <reportElement x="313" y="3" width="61" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center"><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Mínimo]]></text>
            </staticText>
            <staticText>
                <reportElement x="376" y="3" width="96" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Caducidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="474" y="3" width="324" height="14" forecolor="#FFFFFF"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Proveedor]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <frame>
                <reportElement x="0" y="0" width="802" height="15" style="Row"/>
                <textField isBlankWhenNull="true">
                    <reportElement x="4" y="2" width="161" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="167" y="2" width="81" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{tipo_ingrediente}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="250" y="2" width="61" height="11"/>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{cantidad_stock}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="313" y="2" width="61" height="11"/>
                    <textElement textAlignment="Center"><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{cantidad_minima_stock}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true" pattern="dd/MM/yyyy">
                    <reportElement x="376" y="2" width="96" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{fecha_caducidad}]]></textFieldExpression>
                </textField>
                <textField isBlankWhenNull="true">
                    <reportElement x="474" y="2" width="324" height="11"/>
                    <textElement><font fontName="Arial" size="9"/></textElement>
                    <textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression>
                </textField>
            </frame>
            <line>
                <reportElement x="0" y="15" width="802" height="1"
                               forecolor="#CCCCCC" positionType="FixRelativeToBottom"/>
                <graphicElement><pen lineWidth="0.3"/></graphicElement>
            </line>
        </band>
    </detail>

    <columnFooter>
        <band height="6" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="802" height="1" forecolor="#004AAD"/>
                <graphicElement><pen lineWidth="1.0"/></graphicElement>
            </line>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="22" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="4" y="2" width="200" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="206" y="2" width="390" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="8" isBold="true"/></textElement>
                <text><![CDATA[DOMINO'S PIZZA — Sistema de Gestión]]></text>
            </staticText>
            <textField>
                <reportElement x="598" y="2" width="100" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="700" y="2" width="98" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle"><font fontName="Arial" size="8"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="28" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="4" width="802" height="20"
                               forecolor="#E8F0FB" backcolor="#E8F0FB" mode="Opaque"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="4" y="8" width="130" height="12" forecolor="#004AAD"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <text><![CDATA[Total de ingredientes:]]></text>
            </staticText>
            <textField>
                <reportElement x="136" y="8" width="50" height="12" forecolor="#BE1E1E"/>
                <textElement><font fontName="Arial" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalIngredientes}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
