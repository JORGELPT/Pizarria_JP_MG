<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Ingrediente"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #004aad; -fx-padding: 14 24 14 24;">
            <Label text="🍅  Agregar Ingrediente"
                   style="-fx-text-fill: white; -fx-font-size: 17px;
                          -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <!-- Nombre | Cantidad stock | Cant. mín. -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Nombre" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTnombre" promptText="Masa, salsa, queso..." prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Cantidad en Stock" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTcantidad" promptText="Ej: 3000" prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Cant. Mín. del Stock" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTcantMin" prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
            </HBox>

            <!-- Fecha | Tipo | Proveedor -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Fecha de caducidad (yyyy-MM-dd)" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTfecha" promptText="2026-12-31" prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Tipo de Ingr." style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" prefHeight="38"
                              style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                     -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                     -fx-font-size: 13px;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Proveedor" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cmbProveedor" maxWidth="Infinity" prefHeight="38"
                              style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                     -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                     -fx-font-size: 13px;"/>
                </VBox>
            </HBox>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" onAction="#FnGuardar"
                        style="-fx-background-color: #004aad; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Button text="Eliminar" onAction="#FnEliminar"
                        style="-fx-background-color: #be1e1e; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Editar" onAction="#FnEditar"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Button text="🔍 Buscar" onAction="#FnBuscar"
                        style="-fx-background-color: #004aad; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 13px;"/>
            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tablaIngredientes" VBox.vgrow="ALWAYS"
                       style="-fx-border-color: #e8eef8; -fx-border-width: 1; -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="colNombre"    prefWidth="160" text="Nombre"/>
                    <TableColumn fx:id="colTipo"      prefWidth="100" text="Tipo"/>
                    <TableColumn fx:id="colStock"     prefWidth="80"  text="Stock"/>
                    <TableColumn fx:id="colCantMin"   prefWidth="90"  text="Cant. Min."/>
                    <TableColumn fx:id="colFecha"     prefWidth="120" text="F. Caducidad"/>
                    <TableColumn fx:id="colProveedor" prefWidth="160" text="Proveedor"/>
                </columns>
                <placeholder><Label text="Sin registros." style="-fx-text-fill: #aaa;"/></placeholder>
            </TableView>

        </VBox>
    </VBox>
</AnchorPane>
