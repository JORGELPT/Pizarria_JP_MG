<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Departamento"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="content-header">
            <Label text="■  Agregar Departamento" styleClass="content-header-title"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <VBox spacing="5">
                <Label text="Nombre" styleClass="field-label"/>
                <TextField fx:id="TXTnombre" prefHeight="38" styleClass="field-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Descripción" styleClass="field-label"/>
                <TextField fx:id="TXTDescripcion" prefHeight="38" styleClass="field-input"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" onAction="#FnGuardar" styleClass="btn-primary"/>
                <Button text="Eliminar" onAction="#FnEliminar" styleClass="btn-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Editar" onAction="#FnEditar" styleClass="btn-secondary"/>
                <Button text="🔍 Buscar" onAction="#FnBuscar" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tablaDepartamentos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre"      prefWidth="240" text="Nombre"/>
                    <TableColumn fx:id="colDescripcion" prefWidth="400" text="Descripción"/>
                </columns>
                <placeholder><Label text="Sin registros." styleClass="info-label"/></placeholder>
            </TableView>

        </VBox>
    </VBox>
</AnchorPane>
