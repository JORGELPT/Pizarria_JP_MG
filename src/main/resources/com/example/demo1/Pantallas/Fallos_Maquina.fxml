<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: #f4f6fb;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Fallosmaquina">

    <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="content-header">
            <Label text="⚠  Fallos de Máquina" styleClass="content-header-title"/>
        </HBox>

        <VBox spacing="14" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20" left="26" right="26" top="20"/></padding>

            <HBox spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Tipo" styleClass="field-label"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" prefHeight="38" styleClass="field-combo"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Serie de máquina" styleClass="field-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="TXTserieMaquina" prefHeight="38" styleClass="field-input" HBox.hgrow="ALWAYS"/>
                        <Button onAction="#FnBuscarMaquina" text="🔍" styleClass="btn-search"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Descripción" styleClass="field-label"/>
                    <TextField fx:id="TXTdescripcion" prefHeight="38" styleClass="field-input"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Id de empleado" styleClass="field-label"/>
                    <TextField fx:id="TXTidEmpleado" prefHeight="38" styleClass="field-input"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button onAction="#FnGuardar" text="Guardar" styleClass="btn-primary"/>
                <Button onAction="#FnEliminar" text="Eliminar" styleClass="btn-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#FnEditar" text="Editar" styleClass="btn-secondary"/>
                <Button onAction="#FnBuscar" text="🔍 Buscar" styleClass="btn-primary"/>
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>
