<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Fallosmaquina"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #004aad; -fx-padding: 14 24 14 24;">
            <Label text="⚙️  Fallos de Máquina"
                   style="-fx-text-fill: white; -fx-font-size: 17px;
                          -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <!-- Tipo | Serie de máquina -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Tipo" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <ComboBox fx:id="cmbTipo" maxWidth="Infinity" prefHeight="38"
                              style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                     -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                     -fx-font-size: 13px;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Serie de máquina" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <HBox spacing="8">
                        <TextField fx:id="TXTserieMaquina" prefHeight="38" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                          -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                          -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                        <Button text="🔍" onAction="#FnBuscarMaquina" prefHeight="38" prefWidth="42"
                                style="-fx-background-color: #004aad; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 14px;"/>
                    </HBox>
                    <Label fx:id="lblIdMaquina" text="ID máquina: —"
                           style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                </VBox>
            </HBox>

            <!-- Descripción | Id empleado -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Descripción" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTdescripcion" prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Id de empleado" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #555;"/>
                    <TextField fx:id="TXTidEmpleado" prefHeight="38"
                               style="-fx-background-color: #f0f4ff; -fx-background-radius: 10;
                                      -fx-border-color: #dde6f5; -fx-border-radius: 10; -fx-border-width: 1.5;
                                      -fx-font-size: 13px; -fx-text-fill: #1a1a2e; -fx-padding: 0 12;"/>
                </VBox>
            </HBox>

            <!-- Botones -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" onAction="#FnGuardar"
                        style="-fx-background-color: #004aad; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Button text="Eliminar" onAction="#FnEliminar"
                        style="-fx-background-color: #be1e1e; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Editar" onAction="#FnEditar"
                        style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 22; -fx-font-size: 13px;"/>
                <Button text="🔍 Buscar" onAction="#FnBuscar"
                        style="-fx-background-color: #004aad; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 13px;"/>
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>