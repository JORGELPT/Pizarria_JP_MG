<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_hace_ub_pedido"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #f4f6fb;">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-padding: 12 22 12 22;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 3);">
            <VBox spacing="2">
                <Label fx:id="lblFecha" text=""
                       style="-fx-text-fill: #aaa; -fx-font-size: 11px; -fx-font-family: 'Segoe UI';"/>
                <Label text="🍕  Hacer un Pedido"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="🔍  Buscar producto..."
                       prefWidth="300" prefHeight="38" onKeyReleased="#FnBuscar"
                       style="-fx-background-color: #f0f4ff; -fx-background-radius: 20;
                              -fx-border-color: transparent; -fx-font-size: 13px;
                              -fx-padding: 0 16 0 16; -fx-font-family: 'Segoe UI';"/>
        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <HBox spacing="0">

            <!-- ══════════════ CATÁLOGO ══════════════ -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f4f6fb;">

                <!-- Encabezado del catálogo -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 18 20 8 20;">
                    <Label text="Encuentra el Mejor Producto"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';"
                           HBox.hgrow="ALWAYS"/>
                    <Button text="Ver Todo" onAction="#FnFiltrarTodos"
                            style="-fx-background-color: transparent; -fx-text-fill: #004aad;
                                   -fx-font-size: 12px; -fx-cursor: hand; -fx-border-color: transparent;
                                   -fx-font-weight: bold;"/>
                </HBox>

                <!-- Tabs de categoría (pills) -->
                <HBox fx:id="hboxTabs" spacing="8" alignment="CENTER_LEFT"
                      style="-fx-padding: 4 20 12 20;">
                    <Button fx:id="btnTodos"   text="Todos"      onAction="#FnFiltrarTodos"
                            style="-fx-background-color: #004aad; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 7 20 7 20;
                                   -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Button fx:id="btnPizza"   text="🍕 Pizza"   onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 7 18 7 18;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnBebida"  text="🥤 Bebida"  onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 7 18 7 18;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnPasta"   text="🍝 Pasta"   onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 7 18 7 18;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnPostre"  text="🍰 Postre"  onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 7 18 7 18;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnOfertas" text="⭐ Ofertas" onAction="#FnFiltrarOfertas"
                            style="-fx-background-color: #fff3cd; -fx-text-fill: #856404;
                                   -fx-background-radius: 20; -fx-padding: 7 18 7 18;
                                   -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Grid de productos -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <FlowPane fx:id="flowProductos" hgap="16" vgap="16"
                              style="-fx-background-color: transparent;">
                        <padding><Insets top="8" right="20" bottom="20" left="20"/></padding>
                    </FlowPane>
                </ScrollPane>

            </VBox>

            <!-- ══════════════ PANEL PEDIDO ══════════════ -->
            <VBox minWidth="340" maxWidth="380"
                  style="-fx-background-color: white;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, -3, 0);">

                <!-- Header azul -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #004aad; -fx-padding: 16 16 16 18;">
                    <Label text="🛒  Mi Pedido"
                           style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-font-family: 'Segoe UI';"
                           HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#FnLimpiar"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                                   -fx-background-radius: 50; -fx-min-width: 30; -fx-min-height: 30;
                                   -fx-max-width: 30; -fx-max-height: 30; -fx-cursor: hand; -fx-padding: 0;"/>
                </HBox>

                <!-- Tipo de entrega -->
                <HBox spacing="6"
                      style="-fx-background-color: #f4f6fb; -fx-padding: 10 14 10 14;">
                    <ToggleButton fx:id="tglEnLocal"  text="En Local"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#FnEntregaEnLocal"
                                  style="-fx-background-color: #004aad; -fx-text-fill: white;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 7 5;"/>
                    <ToggleButton fx:id="tglRecoger"  text="Recoger"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#FnEntregaRecoger"
                                  style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-padding: 7 5;"/>
                    <ToggleButton fx:id="tglDelivery" text="Delivery"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#FnEntregaDelivery"
                                  style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-padding: 7 5;"/>
                </HBox>

                <!-- Cliente -->
                <VBox spacing="6"
                      style="-fx-padding: 12 14 10 14;
                             -fx-border-color: transparent transparent #f0f0f0 transparent;
                             -fx-border-width: 0 0 1 0;">
                    <Label text="👤  Cliente"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtCedula" promptText="Cédula del cliente"
                                   HBox.hgrow="ALWAYS" onAction="#FnBuscarCliente"
                                   style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;
                                          -fx-border-color: transparent; -fx-padding: 8 12; -fx-font-size: 12px;"/>
                        <Button text="Buscar" onAction="#FnBuscarCliente"
                                style="-fx-background-color: #004aad; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 8 14;
                                       -fx-cursor: hand; -fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="lblCliente" text=""
                           style="-fx-text-fill: #004aad; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Lista de ítems -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="vboxItems" spacing="8"
                          style="-fx-background-color: transparent;">
                        <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                    </VBox>
                </ScrollPane>

                <!-- Extra -->
                <VBox spacing="5"
                      style="-fx-padding: 6 14 8 14;
                             -fx-border-color: #f0f0f0 transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;">
                    <Label text="Extra / Ingrediente adicional"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <ComboBox fx:id="cmbExtra" promptText="Sin extra" maxWidth="Infinity"
                              style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;
                                     -fx-border-color: transparent;"/>
                </VBox>

                <!-- Delivery (oculta por defecto) -->
                <VBox fx:id="vboxDelivery" spacing="5" visible="false" managed="false"
                      style="-fx-padding: 6 14 8 14; -fx-background-color: #f8f9ff;">
                    <Label text="Método de Envío"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <ComboBox fx:id="cmbMetodoEnvio" promptText="Seleccionar..."
                              maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: transparent;"/>
                    <Label text="Dirección de entrega"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <TextField fx:id="txtDireccion" promptText="Ej: Calle 5, No. 10…"
                               style="-fx-background-color: white; -fx-background-radius: 10;
                                      -fx-border-color: transparent; -fx-padding: 8 12; -fx-font-size: 12px;"/>
                    <Label text="Observaciones"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <TextField fx:id="txtObservacion" promptText="Indicaciones adicionales…"
                               style="-fx-background-color: white; -fx-background-radius: 10;
                                      -fx-border-color: transparent; -fx-padding: 8 12; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Totales -->
                <VBox spacing="6"
                      style="-fx-background-color: #f8f9ff; -fx-padding: 12 16 12 16;
                             -fx-border-color: #e8eef8 transparent #e8eef8 transparent;
                             -fx-border-width: 1 0 1 0;">
                    <HBox>
                        <Label text="Subtotal"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSubtotal" text="$0.00"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>
                    <HBox>
                        <Label text="Descuento"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDescuento" text="-$0.00"
                               style="-fx-font-size: 12px; -fx-text-fill: #28a745;"/>
                    </HBox>
                    <HBox>
                        <Label fx:id="lblItbsNombre" text="ITBIS (18%)"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblItbs" text="$0.00"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #dde3f0;"/>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotal" text="$0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #004aad;"/>
                    </HBox>
                </VBox>

                <!-- Método de pago -->
                <VBox spacing="6" style="-fx-padding: 10 14 8 14;">
                    <Label text="💳  Método de Pago"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <HBox spacing="6">
                        <ToggleButton fx:id="tglEfectivo" text="Efectivo"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #004aad; -fx-text-fill: white;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 8 0;"/>
                        <ToggleButton fx:id="tglTarjeta"  text="Tarjeta"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-padding: 8 0;"/>
                        <ToggleButton fx:id="tglEWallet"  text="E-Wallet"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-padding: 8 0;"/>
                    </HBox>
                </VBox>

                <!-- Checkout -->
                <VBox style="-fx-padding: 8 14 20 14;">
                    <Label fx:id="lblMensaje" text=""
                           style="-fx-text-fill: #be1e1e; -fx-font-size: 11px; -fx-padding: 0 0 6 0; -fx-wrap-text: true;"/>
                    <Button text="Registrar Pedido  →" maxWidth="Infinity" onAction="#FnGuardar"
                            style="-fx-background-color: #be1e1e; -fx-text-fill: white;
                                   -fx-background-radius: 12; -fx-padding: 14 0;
                                   -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>