<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_hace_ub_pedido"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #f4f6fb;">

    <!-- ═══════════════════════ TOP BAR ═══════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14"
              style="-fx-background-color: white; -fx-padding: 12 22 12 22;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 3);">

            <VBox spacing="2">
                <Label fx:id="lblFecha" text=""
                       style="-fx-text-fill: #aaa; -fx-font-size: 11px;"/>
                <Label text="Hacer un Pedido"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #004aad;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar" promptText="Buscar producto..."
                       prefWidth="280" prefHeight="36"
                       onKeyReleased="#FnBuscar"
                       style="-fx-background-color: #f0f4ff; -fx-background-radius: 20;
                              -fx-border-color: transparent; -fx-font-size: 13px;
                              -fx-padding: 0 16 0 16;"/>
        </HBox>
    </top>

    <!-- ═══════════════════════ CENTER ═══════════════════════ -->
    <center>
        <HBox spacing="0" maxWidth="Infinity" maxHeight="Infinity">

            <!-- ══════════ CATÁLOGO (izquierda) ══════════ -->
            <VBox HBox.hgrow="ALWAYS"
                  maxWidth="Infinity" maxHeight="Infinity"
                  style="-fx-background-color: #f4f6fb;">

                <!-- Título y enlace "Ver Todo" -->
                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 16 20 6 20;">
                    <Label text="Catálogo de Productos"
                           style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                           HBox.hgrow="ALWAYS"/>
                    <Button text="Ver Todo" onAction="#FnFiltrarTodos"
                            style="-fx-background-color: transparent; -fx-text-fill: #004aad;
                                   -fx-font-size: 12px; -fx-cursor: hand;
                                   -fx-border-color: transparent; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Pills de categoría -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-padding: 4 20 12 20;">
                    <Button fx:id="btnTodos"   text="Todos"   onAction="#FnFiltrarTodos"
                            style="-fx-background-color: #004aad; -fx-text-fill: white;
                                   -fx-background-radius: 20; -fx-padding: 6 18;
                                   -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Button fx:id="btnPizza"   text="Pizza"   onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnBebida"  text="Bebida"  onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnPasta"   text="Pasta"   onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnPostre"  text="Postre"  onAction="#FnFiltrarCategoria"
                            style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-cursor: hand; -fx-font-size: 12px;"/>
                    <Button fx:id="btnOfertas" text="Ofertas" onAction="#FnFiltrarOfertas"
                            style="-fx-background-color: #fff3cd; -fx-text-fill: #856404;
                                   -fx-background-radius: 20; -fx-padding: 6 16;
                                   -fx-cursor: hand; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Grid de tarjetas de producto -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <FlowPane fx:id="flowProductos" hgap="14" vgap="14"
                              style="-fx-background-color: transparent;">
                        <padding><Insets top="8" right="20" bottom="20" left="20"/></padding>
                    </FlowPane>
                </ScrollPane>

            </VBox>

            <!-- ══════════ PANEL PEDIDO (derecha) ══════════ -->
            <VBox minWidth="345" maxWidth="370"
                  maxHeight="Infinity"
                  style="-fx-background-color: white;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, -3, 0);">

                <!-- Encabezado azul -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #004aad; -fx-padding: 14 16 14 18;">
                    <Label text="Mi Pedido"
                           style="-fx-text-fill: white; -fx-font-size: 16px;
                                  -fx-font-weight: bold;" HBox.hgrow="ALWAYS"/>
                    <Button text="✕" onAction="#FnLimpiar"
                            style="-fx-background-color: rgba(255,255,255,0.2);
                                   -fx-text-fill: white; -fx-background-radius: 50;
                                   -fx-min-width: 28; -fx-min-height: 28;
                                   -fx-max-width: 28; -fx-max-height: 28;
                                   -fx-cursor: hand; -fx-padding: 0;"/>
                </HBox>

                <!-- Tipo de entrega -->
                <HBox spacing="6"
                      style="-fx-background-color: #f4f6fb; -fx-padding: 8 12 8 12;">
                    <ToggleButton fx:id="tglEnLocal"  text="En Local"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                  onAction="#FnEntregaEnLocal"
                                  style="-fx-background-color: #004aad; -fx-text-fill: white;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-font-weight: bold;
                                         -fx-padding: 6 4;"/>
                    <ToggleButton fx:id="tglRecoger"  text="Recoger"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                  onAction="#FnEntregaRecoger"
                                  style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-padding: 6 4;"/>
                    <ToggleButton fx:id="tglDelivery" text="Delivery"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                  onAction="#FnEntregaDelivery"
                                  style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                         -fx-background-radius: 20; -fx-cursor: hand;
                                         -fx-font-size: 11px; -fx-padding: 6 4;"/>
                </HBox>

                <!-- Sección: Cliente -->
                <VBox spacing="5"
                      style="-fx-padding: 10 12 8 12;
                             -fx-border-color: transparent transparent #f0f0f0 transparent;
                             -fx-border-width: 0 0 1 0;">
                    <Label text="Cliente"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <TextField fx:id="txtCedula" promptText="Cédula del cliente"
                                   HBox.hgrow="ALWAYS" onAction="#FnBuscarCliente"
                                   style="-fx-background-color: #f4f6fb;
                                          -fx-background-radius: 10;
                                          -fx-border-color: transparent;
                                          -fx-padding: 7 10; -fx-font-size: 12px;"/>
                        <Button text="Buscar" onAction="#FnBuscarCliente"
                                style="-fx-background-color: #004aad; -fx-text-fill: white;
                                       -fx-background-radius: 10; -fx-padding: 7 12;
                                       -fx-cursor: hand; -fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="lblCliente" text=""
                           style="-fx-text-fill: #004aad; -fx-font-weight: bold;
                                  -fx-font-size: 12px;"/>
                </VBox>

                <!-- Lista de ítems del carrito -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="vboxItems" spacing="6"
                          style="-fx-background-color: transparent;">
                        <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    </VBox>
                </ScrollPane>

                <!-- Extra / ingrediente adicional -->
                <VBox spacing="4"
                      style="-fx-padding: 6 12 6 12;
                             -fx-border-color: #f0f0f0 transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;">
                    <Label text="Extra / Ingrediente"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <ComboBox fx:id="cmbExtra" promptText="Sin extra" maxWidth="Infinity"
                              style="-fx-background-color: #f4f6fb; -fx-background-radius: 10;
                                     -fx-border-color: transparent;"/>
                </VBox>

                <!-- Sección Delivery (oculta por defecto) -->
                <VBox fx:id="vboxDelivery" spacing="4" visible="false" managed="false"
                      style="-fx-padding: 6 12 6 12; -fx-background-color: #f8f9ff;">
                    <Label text="Método de Envío"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <ComboBox fx:id="cmbMetodoEnvio" promptText="Seleccionar..."
                              maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-background-radius: 10;
                                     -fx-border-color: transparent;"/>
                    <Label text="Dirección de entrega"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <TextField fx:id="txtDireccion" promptText="Ej: Calle 5, No. 10..."
                               style="-fx-background-color: white; -fx-background-radius: 10;
                                      -fx-border-color: transparent;
                                      -fx-padding: 7 10; -fx-font-size: 12px;"/>
                    <Label text="Observaciones"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <TextField fx:id="txtObservacion" promptText="Indicaciones adicionales..."
                               style="-fx-background-color: white; -fx-background-radius: 10;
                                      -fx-border-color: transparent;
                                      -fx-padding: 7 10; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Totales -->
                <VBox spacing="5"
                      style="-fx-background-color: #f8f9ff; -fx-padding: 10 14 10 14;
                             -fx-border-color: #e8eef8 transparent #e8eef8 transparent;
                             -fx-border-width: 1 0 1 0;">
                    <HBox>
                        <Label text="Subtotal"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblSubtotal" text="0.00"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>
                    <HBox>
                        <Label text="Descuento"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDescuento" text="0.00"
                               style="-fx-font-size: 12px; -fx-text-fill: #28a745;"/>
                    </HBox>
                    <HBox>
                        <Label fx:id="lblItbsNombre" text="ITBIS (18%)"
                               style="-fx-font-size: 12px; -fx-text-fill: #666;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblItbs" text="0.00"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    </HBox>
                    <Separator style="-fx-background-color: #dde3f0;"/>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="TOTAL"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotal" text="0.00"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #004aad;"/>
                    </HBox>
                </VBox>

                <!-- Método de pago -->
                <VBox spacing="5" style="-fx-padding: 8 12 6 12;">
                    <Label text="Método de Pago"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #888;"/>
                    <HBox spacing="5">
                        <ToggleButton fx:id="tglEfectivo" text="Efectivo"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #004aad; -fx-text-fill: white;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-font-weight: bold;
                                             -fx-padding: 7 0;"/>
                        <ToggleButton fx:id="tglTarjeta"  text="Tarjeta"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-padding: 7 0;"/>
                        <ToggleButton fx:id="tglEWallet"  text="E-Wallet"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                      style="-fx-background-color: #e8eef8; -fx-text-fill: #555;
                                             -fx-background-radius: 10; -fx-cursor: hand;
                                             -fx-font-size: 11px; -fx-padding: 7 0;"/>
                    </HBox>
                </VBox>

                <!-- Botón registrar + mensaje -->
                <VBox style="-fx-padding: 6 12 16 12;">
                    <Label fx:id="lblMensaje" text=""
                           wrapText="true"
                           style="-fx-text-fill: #be1e1e; -fx-font-size: 11px;
                                  -fx-padding: 0 0 4 0;"/>
                    <Button text="Registrar Pedido" maxWidth="Infinity"
                            onAction="#FnGuardar"
                            style="-fx-background-color: #be1e1e; -fx-text-fill: white;
                                   -fx-background-radius: 12; -fx-padding: 13 0;
                                   -fx-cursor: hand; -fx-font-size: 14px;
                                   -fx-font-weight: bold;"/>
                </VBox>

            </VBox>
            <!-- fin panel pedido -->

        </HBox>
    </center>

</BorderPane>