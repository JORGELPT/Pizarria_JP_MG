<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.Controller_Inventario"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="content-header">
            <Label text="☰  Inventario" styleClass="content-header-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="TXTbuscar" promptText="Buscar ingrediente..."
                       prefHeight="36" prefWidth="240"
                       style="-fx-background-color: rgba(255,255,255,0.18);
                              -fx-background-radius: 20; -fx-border-color: rgba(255,255,255,0.4);
                              -fx-border-radius: 20; -fx-border-width: 1;
                              -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.6);
                              -fx-padding: 0 16 0 16; -fx-font-size: 13px;"/>
            <Button text="Buscar" onAction="#FnBuscar"
                    style="-fx-background-color: white; -fx-text-fill: #004aad;
                           -fx-font-weight: bold; -fx-background-radius: 20;
                           -fx-cursor: hand; -fx-padding: 8 18; -fx-font-size: 13px;"/>
        </HBox>

        <HBox spacing="20" VBox.vgrow="ALWAYS"
              style="-fx-background-color: #f4f6fb;">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <VBox spacing="12" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 14, 0, 0, 3);">
                <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

                <Label text="Stock actual"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';"/>

                <TableView fx:id="tablaInventario" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"        prefWidth="60"  text="ID"/>
                        <TableColumn fx:id="colNombre"    prefWidth="160" text="Nombre"/>
                        <TableColumn fx:id="colCategoria" prefWidth="130" text="Categoría"/>
                        <TableColumn fx:id="colFechaExp"  prefWidth="130" text="Fecha EXP"/>
                        <TableColumn fx:id="colCantStock" prefWidth="120" text="Cant. Stock"/>
                        <TableColumn fx:id="colCantMin"   prefWidth="110" text="Cant. Mín."/>
                    </columns>
                    <placeholder>
                        <Label text="Sin registros." styleClass="info-label"/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox spacing="16" minWidth="200" maxWidth="220" alignment="TOP_CENTER"
                  style="-fx-background-color: white;
                         -fx-background-radius: 14;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 14, 0, 0, 3);">
                <padding><Insets top="28" right="18" bottom="28" left="18"/></padding>

                <Label text="Agregar Ingrediente"
                       wrapText="true" alignment="CENTER" textAlignment="CENTER"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';"/>

                <ImageView fitWidth="100" fitHeight="100" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@../imagenes/inventario.png"/></image>
                </ImageView>

                <Button fx:id="btnAgregar" text="Agregar" onAction="#FnAgregarIngrediente"
                        maxWidth="Infinity" styleClass="btn-primary"/>
                <Button text="📄 Exportar PDF" onAction="#FnExportarPDF"
                        maxWidth="Infinity" styleClass="btn-success"/>

                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
