<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Devolucion"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="content-header">
            <Label text="↩  Devolución" styleClass="content-header-title"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="ID de Pedido" styleClass="field-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="TXTidPedido" promptText="Ej: 1001" prefHeight="38"
                                   HBox.hgrow="ALWAYS" styleClass="field-input"/>
                        <Button text="🔍" onAction="#FnBuscarPedido" styleClass="btn-search"/>
                    </HBox>
                    <Label fx:id="lblCliente" text="Cliente: —" styleClass="info-label"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Motivo" styleClass="field-label"/>
                    <ComboBox fx:id="cmbMotivo" maxWidth="Infinity" prefHeight="38" styleClass="field-combo"/>
                </VBox>
            </HBox>

            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Monto a devolver (RD$)" styleClass="field-label"/>
                    <TextField fx:id="TXTmonto" promptText="Ej: 850.00" prefHeight="38" styleClass="field-input"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Fecha" styleClass="field-label"/>
                    <TextField fx:id="TXTfecha" promptText="Ej: 2024-01-15" prefHeight="38" styleClass="field-input"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Descripción" styleClass="field-label"/>
                <TextField fx:id="TXTdescripcion" prefHeight="38" styleClass="field-input"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Guardar" onAction="#FnGuardar" styleClass="btn-primary"/>
                <Button text="Eliminar" onAction="#FnEliminar" styleClass="btn-danger"/>
                <Button text="Inhabilitar" onAction="#FnInhabilitar" styleClass="btn-warning"/>
                <Button text="Habilitar" onAction="#FnHabilitar" styleClass="btn-success"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Editar" onAction="#FnEditar" styleClass="btn-secondary"/>
                <Button text="🔍 Buscar" onAction="#FnBuscar" styleClass="btn-primary"/>
            </HBox>

            <TableView fx:id="tablaDevoluciones" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPedido" prefWidth="110" text="ID Pedido"/>
                    <TableColumn fx:id="colCliente"  prefWidth="200" text="Cliente"/>
                    <TableColumn fx:id="colMotivo"   prefWidth="170" text="Motivo"/>
                    <TableColumn fx:id="colMonto"    prefWidth="120" text="Monto (RD$)"/>
                    <TableColumn fx:id="colFecha"    prefWidth="120" text="Fecha"/>
                    <TableColumn fx:id="colEstado"   prefWidth="100" text="Estado"/>
                </columns>
                <placeholder><Label text="Sin registros." styleClass="info-label"/></placeholder>
            </TableView>

        </VBox>
    </VBox>
</AnchorPane>
