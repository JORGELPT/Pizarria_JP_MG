<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Envio"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="content-header">
            <Label text="🚚  Envío / Delivery" styleClass="content-header-title"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <!-- Seleccione un registro de la tabla para editar la dirección -->
            <HBox spacing="20">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="ID de Pedido" styleClass="field-label"/>
                    <HBox spacing="8">
                        <TextField fx:id="TXTidPedido" promptText="Seleccione de la tabla o escriba ID"
                                   prefHeight="38" HBox.hgrow="ALWAYS" styleClass="field-input"/>
                        <Button text="🔍" onAction="#FnBuscar" styleClass="btn-search"/>
                    </HBox>
                    <Label fx:id="lblCliente" text="Cliente: —" styleClass="info-label"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Dirección de entrega" styleClass="field-label"/>
                    <TextField fx:id="TXTdireccion" promptText="Nueva dirección..."
                               prefHeight="38" styleClass="field-input"/>
                    <Label text="Seleccione un envío de la tabla y modifique la dirección aquí."
                           style="-fx-text-fill: #888; -fx-font-size: 10px;"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Actualizar Dirección" onAction="#FnActualizarDireccion" styleClass="btn-primary"/>
                <Button text="Eliminar"              onAction="#FnEliminar"            styleClass="btn-danger"/>
                <Button text="Inhabilitar"           onAction="#FnInhabilitar"         styleClass="btn-warning"/>
                <Button text="Habilitar"             onAction="#FnHabilitar"           styleClass="btn-success"/>
            </HBox>

            <TableView fx:id="tablaEnvios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPedido"    prefWidth="90"  text="ID Pedido"/>
                    <TableColumn fx:id="colCliente"     prefWidth="210" text="Cliente"/>
                    <TableColumn fx:id="colDireccion"   prefWidth="270" text="Dirección"/>
                    <TableColumn fx:id="colMetodoEnvio" prefWidth="110" text="Método"/>
                    <TableColumn fx:id="colEstado"      prefWidth="100" text="Estado"/>
                </columns>
                <placeholder><Label text="Sin registros de envío." styleClass="info-label"/></placeholder>
            </TableView>

        </VBox>
    </VBox>
</AnchorPane>
