<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.demo1.Controllers.CONTROLLER_Login"
           maxWidth="Infinity" maxHeight="Infinity">

    <!-- FONDO OSCURO -->
    <Region maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #000d2e;"/>

    <!-- BRILLO INFERIOR -->
    <Region maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: radial-gradient(center 50% 110%, radius 70%, rgba(0,74,173,0.55), transparent);"/>

    <!-- BRILLO SUPERIOR DERECHO -->
    <Region maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: radial-gradient(center 85% 10%, radius 45%, rgba(0,50,140,0.35), transparent);"/>

    <!-- TARJETA GLASS CENTRADA -->
    <VBox alignment="CENTER" maxWidth="Infinity" maxHeight="Infinity">

        <VBox alignment="CENTER" spacing="18" prefWidth="380" maxWidth="380"
              style="-fx-background-color: rgba(255,255,255,0.06);
                     -fx-border-color: rgba(255,255,255,0.18);
                     -fx-border-width: 1.5;
                     -fx-border-radius: 22;
                     -fx-background-radius: 22;
                     -fx-effect: dropshadow(gaussian, rgba(0,80,220,0.50), 50, 0, 0, 0);">
            <padding><Insets top="44" right="48" bottom="44" left="48"/></padding>

            <!-- LOGO DOMINO'S -->
            <StackPane alignment="CENTER">
                <Region prefWidth="90" prefHeight="90"
                        style="-fx-background-color: rgba(255,255,255,0.10);
                               -fx-background-radius: 45;
                               -fx-border-color: rgba(255,255,255,0.20);
                               -fx-border-radius: 45;
                               -fx-border-width: 1.5;
                               -fx-effect: dropshadow(gaussian, rgba(0,100,255,0.4), 20, 0, 0, 0);"/>
                <ImageView fitWidth="62" fitHeight="62" preserveRatio="true" pickOnBounds="true">
                    <image><Image url="@../imagenes/Logo.png"/></image>
                </ImageView>
            </StackPane>

            <!-- TÍTULOS -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="DOMINO'S PIZZA"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                <Label text="Sistema de Gestión"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: rgba(255,255,255,0.50);
                              -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <!-- CAMPO USUARIO -->
            <HBox maxWidth="Infinity" alignment="CENTER_LEFT" prefHeight="46"
                  style="-fx-background-color: rgba(0,20,80,0.55);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(255,255,255,0.18);
                         -fx-border-radius: 10;
                         -fx-border-width: 1.2;">
                <Label text="●"
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-padding: 0 8 0 16;"/>
                <TextField fx:id="TXTusuario"
                           promptText="Usuario"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: rgba(255,255,255,0.38);
                                  -fx-font-size: 13px;
                                  -fx-font-family: 'Segoe UI';
                                  -fx-border-color: transparent;
                                  -fx-padding: 0 14 0 4;"/>
            </HBox>

            <!-- CAMPO CONTRASEÑA -->
            <HBox maxWidth="Infinity" alignment="CENTER_LEFT" prefHeight="46"
                  style="-fx-background-color: rgba(0,20,80,0.55);
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(255,255,255,0.18);
                         -fx-border-radius: 10;
                         -fx-border-width: 1.2;">
                <Label text="■"
                       style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.45);
                              -fx-padding: 0 8 0 16;"/>
                <PasswordField fx:id="TXTcontrasena"
                               promptText="Contraseña"
                               HBox.hgrow="ALWAYS"
                               onAction="#FnIniciarSesion"
                               style="-fx-background-color: transparent;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: rgba(255,255,255,0.38);
                                      -fx-font-size: 13px;
                                      -fx-font-family: 'Segoe UI';
                                      -fx-border-color: transparent;
                                      -fx-padding: 0 14 0 4;"/>
            </HBox>

            <!-- BOTÓN LOGIN -->
            <Button text="INICIAR SESIÓN"
                    maxWidth="Infinity" prefHeight="46"
                    onAction="#FnIniciarSesion"
                    style="-fx-background-color: #004aad;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 13px;
                           -fx-letter-spacing: 1px;
                           -fx-font-family: 'Segoe UI';
                           -fx-background-radius: 10;
                           -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,100,255,0.55), 16, 0, 0, 4);"/>

            <!-- MENSAJE DE ERROR -->
            <Label fx:id="lblError" text=""
                   maxWidth="Infinity" wrapText="true" alignment="CENTER"
                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;
                          -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;"/>

        </VBox>

        <!-- PIE -->
        <Region prefHeight="18"/>
        <Label text="Domino's Pizza © 2025 — v1.0.0"
               style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.25);
                      -fx-font-family: 'Segoe UI';"/>

    </VBox>

</StackPane>
