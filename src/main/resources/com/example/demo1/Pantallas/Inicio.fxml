<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: #f4f6fb;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo1.Controllers.CONTROLLER_inicio">

    <VBox spacing="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- HEADER AZUL -->
        <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-background-color: linear-gradient(to right, #000d2e, #001a5c); -fx-border-color: #be1e1e; -fx-border-width: 0 0 3 0; -fx-padding: 18 28 18 28;">
            <VBox spacing="3">
                <Label style="-fx-text-fill: white; -fx-font-size: 22px;                               -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" text="¡Bienvenido!" />
                <Label style="-fx-text-fill: rgba(255,255,255,0.75);                               -fx-font-size: 13px; -fx-font-family: 'Segoe UI';" text="¿Qué deseas hacer hoy?" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                <image><Image url="@../imagenes/p1-removebg-preview.png"/></image>
            </ImageView>
        </HBox>

        <!-- TARJETAS DE ACCESO RÁPIDO -->
        <HBox alignment="CENTER" spacing="28" style="-fx-background-color: #f4f6fb;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="40" left="48" right="48" top="40" /></padding>

            <!-- TARJETA: REGISTRAR PEDIDO -->
            <VBox alignment="CENTER" onMouseClicked="#abrirRegistrarPedidoClick" spacing="20" style="-fx-background-color: white;                          -fx-background-radius: 18;                          -fx-effect: dropshadow(gaussian, rgba(0,74,173,0.12), 18, 0, 0, 5);                          -fx-cursor: hand; -fx-border-color: #e8eef8;                          -fx-border-width: 1.5; -fx-border-radius: 18;" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="40" left="30" right="30" top="40" /></padding>

                <StackPane>
                    <Region prefHeight="110" prefWidth="110" style="-fx-background-color: #e8f0fe; -fx-background-radius: 55;" />
                    <ImageView fitHeight="80" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../imagenes/p1.png" /></image>
                    </ImageView>
                </StackPane>

                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold;                                   -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';" text="Registrar Pedido" />
                    <Label alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: #888;                                   -fx-font-family: 'Segoe UI';" text="Crea un nuevo pedido para un cliente" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <Button styleClass="btn-primary" text="Ir →" onAction="#abrirRegistrarPedido"/>
            </VBox>

            <!-- TARJETA: RECLAMACIÓN -->
            <VBox alignment="CENTER" onMouseClicked="#abrirReclamacionClick" spacing="20" style="-fx-background-color: white;                          -fx-background-radius: 18;                          -fx-effect: dropshadow(gaussian, rgba(190,30,30,0.10), 18, 0, 0, 5);                          -fx-cursor: hand; -fx-border-color: #fde8e8;                          -fx-border-width: 1.5; -fx-border-radius: 18;" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="40" left="30" right="30" top="40" /></padding>

                <StackPane>
                    <Region prefHeight="110" prefWidth="110" style="-fx-background-color: #fdecea; -fx-background-radius: 55;" />
                    <ImageView fitHeight="80" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../imagenes/reporte.png" /></image>
                    </ImageView>
                </StackPane>

                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold;                                   -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';" text="Reclamación" />
                    <Label alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: #888;                                   -fx-font-family: 'Segoe UI';" text="Registra una reclamación de pedido" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <Button styleClass="btn-danger" text="Ir →" onAction="#abrirReclamacion"/>
            </VBox>

            <!-- TARJETA: REGISTRAR CLIENTE -->
            <VBox alignment="CENTER" onMouseClicked="#abrirRegistrarClienteClick" spacing="20" style="-fx-background-color: white;                          -fx-background-radius: 18;                          -fx-effect: dropshadow(gaussian, rgba(0,74,173,0.12), 18, 0, 0, 5);                          -fx-cursor: hand; -fx-border-color: #e8eef8;                          -fx-border-width: 1.5; -fx-border-radius: 18;" HBox.hgrow="ALWAYS">
                <padding><Insets bottom="40" left="30" right="30" top="40" /></padding>

                <StackPane>
                    <Region prefHeight="110" prefWidth="110" style="-fx-background-color: #e8f0fe; -fx-background-radius: 55;" />
                    <ImageView fitHeight="80" fitWidth="80" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../imagenes/Cliente.png" /></image>
                    </ImageView>
                </StackPane>

                <VBox alignment="CENTER" spacing="6">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold;                                   -fx-text-fill: #1a1a2e; -fx-font-family: 'Segoe UI';" text="Registrar Cliente" />
                    <Label alignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: #888;                                   -fx-font-family: 'Segoe UI';" text="Agrega un nuevo cliente al sistema" textAlignment="CENTER" wrapText="true" />
                </VBox>

                <Button styleClass="btn-primary" text="Ir →" onAction="#abrirRegistrarCliente"/>
            </VBox>

        </HBox>
    </VBox>
</AnchorPane>
