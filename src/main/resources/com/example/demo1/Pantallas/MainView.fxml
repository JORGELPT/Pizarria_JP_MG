<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.Maincontroller"
            prefHeight="720.0" prefWidth="1280.0"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color: #f4f4f4;">

    <!-- ================= TOP BAR ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: #004aad; -fx-border-color: #8b5cf6; -fx-border-width: 0 0 3 0;">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="10.0"/>
            </padding>

            <!-- Ícono usuario -->
            <Label text="👤" alignment="CENTER"
                   style="-fx-font-size: 20px; -fx-background-color: white;
                          -fx-background-radius: 50;
                          -fx-min-width: 38; -fx-min-height: 38;
                          -fx-max-width: 38; -fx-max-height: 38;"/>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Usuario — minWidth="0" para que pueda encogerse con ellipsis -->
            <Label fx:id="lblUsuario" text="Administrador"
                   minWidth="0" maxWidth="280"
                   style="-fx-text-fill: white; -fx-font-size: 12px; -fx-text-overrun: ellipsis;">
                <font><Font size="12.0"/></font>
            </Label>

            <Separator orientation="VERTICAL"
                       style="-fx-background-color: rgba(255,255,255,0.3); -fx-pref-height: 20;"/>

            <!-- Fecha -->
            <Label fx:id="lblFecha" text="--/--/----"
                   style="-fx-text-fill: white; -fx-font-size: 12px;">
                <font><Font size="12.0"/></font>
            </Label>

            <Label text="🍕" style="-fx-font-size: 24px;"/>
        </HBox>
    </top>

    <!-- ================= SIDE MENU ================= -->
    <left>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #d9e7ff; -fx-background-color: #d9e7ff;
                           -fx-border-color: transparent;">
            <VBox fx:id="sideMenu" prefWidth="255.0" spacing="2.0"
                  style="-fx-background-color: #d9e7ff;">
                <padding>
                    <Insets bottom="15.0" left="5.0" right="5.0" top="10.0"/>
                </padding>

                <!-- ====== INICIO ====== -->
                <Button maxWidth="Infinity" onAction="#abrirInicio"
                        text="🏠  Inicio"
                        style="-fx-background-color: #4a90e2; -fx-text-fill: white;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 9 12 9 12;
                               -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;"/>

                <!-- ====== INVENTARIO ====== -->
                <Button maxWidth="Infinity" onAction="#abrirInventario"
                        text="📦  Inventario"
                        style="-fx-background-color: transparent; -fx-text-fill: #000;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 9 12 9 12;
                               -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;"/>

                <!-- ====== COMPRAS ====== -->
                <TitledPane text="🛒  Compras" expanded="false"
                            style="-fx-font-weight: bold; -fx-font-size: 13px;">
                    <content>
                        <VBox spacing="1.0" style="-fx-background-color: #d9e7ff;">
                            <Button maxWidth="Infinity" onAction="#abrirAgregarProveedor"
                                    text="🚚  Agregar Proveedor"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirComprasPago"
                                    text="🧾  Comprobante / Pago"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirDevolucion"
                                    text="↩️  Devolución"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- ====== VENTAS ====== -->
                <TitledPane text="🍕  Ventas" expanded="false"
                            style="-fx-font-weight: bold; -fx-font-size: 13px;">
                    <content>
                        <VBox spacing="1.0" style="-fx-background-color: #d9e7ff;">
                            <Button maxWidth="Infinity" onAction="#abrirHacerPedido"
                                    text="📝  Hacer un Pedido"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirRegistroCliente"
                                    text="👤  Registro de Cliente"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAgregarProducto"
                                    text="🍕  Agregar Producto"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirEnvio"
                                    text="🚚  Envío"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirReclamacion"
                                    text="⚠️  Reclamación"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- ====== EQUIPOS Y MANTENIMIENTO ====== -->
                <TitledPane text="🔧  Equipos y Mant." expanded="false"
                            style="-fx-font-weight: bold; -fx-font-size: 13px;">
                    <content>
                        <VBox spacing="1.0" style="-fx-background-color: #d9e7ff;">
                            <Button maxWidth="Infinity" onAction="#abrirAgregarMaquina"
                                    text="🛠️  Agregar Máquina"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAgregarTecnico"
                                    text="🔧  Agregar Técnico"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirMantenimiento"
                                    text="🔩  Mantenimiento"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAperturaCaja"
                                    text="💰  Apertura de Caja"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirFallosMaquina"
                                    text="⚠️  Fallos de Máquina"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- ====== OTRO ====== -->
                <TitledPane text="👥  Otro" expanded="false"
                            style="-fx-font-weight: bold; -fx-font-size: 13px;">
                    <content>
                        <VBox spacing="1.0" style="-fx-background-color: #d9e7ff;">
                            <Button maxWidth="Infinity" onAction="#abrirAgregarEmpleado"
                                    text="👨‍🍳  Agregar Empleado"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAgregarCargo"
                                    text="💼  Agregar Cargo"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAgregarDepartamento"
                                    text="🏢  Agregar Departamento"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirAgregarSucursal"
                                    text="🏪  Agregar Sucursal"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </VBox>
                    </content>
                </TitledPane>

                <!-- ====== REPORTES ====== -->
                <TitledPane text="📊  Reportes" expanded="false"
                            style="-fx-font-weight: bold; -fx-font-size: 13px;">
                    <content>
                        <VBox spacing="1.0" style="-fx-background-color: #d9e7ff;">
                            <Button maxWidth="Infinity" onAction="#abrirReporte1"
                                    text="🔍  Consulta de Empleados"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirReporte2"
                                    text="📊  Reporte 2"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirReporte3"
                                    text="📊  Reporte 3"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirReporte4"
                                    text="📊  Reporte 4"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                            <Button maxWidth="Infinity" onAction="#abrirReporte5"
                                    text="📊  Reporte 5"
                                    style="-fx-background-color: transparent; -fx-text-fill: #333;
                                           -fx-alignment: CENTER_LEFT; -fx-padding: 7 12 7 22;
                                           -fx-cursor: hand; -fx-font-size: 12px;"/>
                        </VBox>
                    </content>
                </TitledPane>

                <Region VBox.vgrow="ALWAYS" minHeight="30"/>

                <!-- ====== SALIR ====== -->
                <Button maxWidth="Infinity" onAction="#salir"
                        text="🚪  Salir"
                        style="-fx-background-color: transparent; -fx-text-fill: #be1e1e;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 9 12 9 12;
                               -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;"/>

            </VBox>
        </ScrollPane>
    </left>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <StackPane fx:id="contentArea"
                   maxWidth="Infinity" maxHeight="Infinity"
                   style="-fx-background-color: white;"/>
    </center>

    <!-- ================= BOTTOM BAR ================= -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: #E9ECEF; -fx-border-color: #CED4DA; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="5.0" left="15.0" right="15.0" top="5.0"/>
            </padding>
            <Label fx:id="lblEstado" text="Listo" style="-fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="v1.0.0" style="-fx-font-size: 11px;"/>
        </HBox>
    </bottom>

</BorderPane>
