<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.Controllers.CONTROLLER_Reporte1"
            style="-fx-background-color: #f4f6fb;">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="content-header">
            <Label text="🍕" style="-fx-font-size: 28px;"/>
            <VBox spacing="2">
                <Label text="DOMINO'S PIZZA" styleClass="content-header-title"/>
                <Label text="Sistema de Gestión" styleClass="content-header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER" spacing="2">
                <Label text="CONSULTA DE EMPLEADOS" styleClass="content-header-title"/>
                <Label text="Reporte #1" styleClass="content-header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblFechaReporte" text="--/--/----"
                   style="-fx-text-fill: rgba(255,255,255,0.85); -fx-font-size: 12px;"/>
        </HBox>

        <VBox spacing="14" VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">
            <padding><Insets top="20" right="26" bottom="20" left="26"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar empleado:" styleClass="field-label"/>
                <TextField fx:id="TXTbuscar" prefHeight="38" prefWidth="240"
                           promptText="Cédula o nombre..." styleClass="field-input"/>
                <Button text="🔍" onAction="#FnBuscar" styleClass="btn-search"/>
                <Button text="Limpiar" onAction="#FnLimpiar" prefHeight="38" styleClass="btn-secondary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="📄 Exportar PDF" onAction="#FnExportarPDF" prefHeight="38" styleClass="btn-danger"/>
                <Button text="↻ Ver Todos" onAction="#FnCargarTodos" prefHeight="38" styleClass="btn-primary"/>
                <Button text="📊 Ver Gráfico" onAction="#FnVerGrafico" prefHeight="38" styleClass="btn-purple"/>
            </HBox>

            <TableView fx:id="tablaEmpleados" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCedula"       prefWidth="110" text="Cédula"/>
                    <TableColumn fx:id="colNombre"       prefWidth="200" text="Nombre"/>
                    <TableColumn fx:id="colTelefono"     prefWidth="120" text="Teléfono"/>
                    <TableColumn fx:id="colCargo"        prefWidth="130" text="Cargo"/>
                    <TableColumn fx:id="colHorario"      prefWidth="120" text="Horario"/>
                    <TableColumn fx:id="colSalario"      prefWidth="100" text="Salario"/>
                    <TableColumn fx:id="colDepartamento" prefWidth="140" text="Departamento"/>
                </columns>
                <placeholder>
                    <Label text="No hay empleados para mostrar." styleClass="info-label"/>
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Total registros:" styleClass="field-label"/>
                <Label fx:id="lblTotal" text="0"
                       style="-fx-font-size: 12px; -fx-text-fill: #004aad; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="DOMINO'S PIZZA — Reporte de Empleados" styleClass="info-label"/>
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>
