<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Reporte_Compras" language="java"
              pageWidth="612" pageHeight="792"
              columnWidth="572" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <style name="Row" isDefault="false">
        <conditionalStyle>
            <conditionExpression><![CDATA[$F{estado} != null && $F{estado}.equalsIgnoreCase("Pendiente")]]></conditionExpression>
            <style backcolor="#FFF8E1" mode="Opaque"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA[($F{estado} == null || !$F{estado}.equalsIgnoreCase("Pendiente")) && $V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
            <style backcolor="#E8F0FB" mode="Opaque"/>
        </conditionalStyle>
    </style>

    <queryString><![CDATA[
        SELECT p.nombre_proveedor                          AS proveedor,
               ISNULL(CONVERT(varchar, c.fecha, 23), '—') AS fecha,
               ISNULL(c.monto, 0)                         AS monto,
               ISNULL(c.monto_pendiente, 0)               AS monto_pendiente,
               c.cantidad,
               ISNULL(c.estado, '—')                      AS estado,
               ISNULL(c.observacion, '')                   AS observacion
        FROM tbl_compra c
        INNER JOIN tbl_proveedor p ON c.id_proveedor = p.id_proveedor
        ORDER BY c.fecha DESC
    ]]></queryString>

    <field name="proveedor"       class="java.lang.String"/>
    <field name="fecha"           class="java.lang.String"/>
    <field name="monto"           class="java.math.BigDecimal"/>
    <field name="monto_pendiente" class="java.math.BigDecimal"/>
    <field name="cantidad"        class="java.lang.Integer"/>
    <field name="estado"          class="java.lang.String"/>
    <field name="observacion"     class="java.lang.String"/>

    <variable name="totalCompras" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[$F{proveedor}]]></variableExpression>
    </variable>
    <variable name="sumaMontos" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{monto}]]></variableExpression>
    </variable>

    <title>
        <band height="100" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="572" height="65"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="10" y="8" width="340" height="50" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="24" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE COMPRAS]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="8" width="218" height="18" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="9"/>
                </textElement>
                <text><![CDATA[DOMINO'S PIZZA | Sistema de Gestión]]></text>
            </staticText>
            <staticText>
                <reportElement x="350" y="30" width="218" height="14" forecolor="#CCE0FF"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <text><![CDATA[República Dominicana]]></text>
            </staticText>
            <textField pattern="'Generado el' dd/MM/yyyy 'a las' HH:mm">
                <reportElement x="0" y="74" width="572" height="14" forecolor="#666666"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="97" width="572" height="1" forecolor="#004AAD"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <pageHeader><band height="5"/></pageHeader>

    <columnHeader>
        <band height="20" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="572" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="4" y="3" width="151" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Proveedor]]></text>
            </staticText>
            <staticText>
                <reportElement x="157" y="3" width="86" height="14" forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="245" y="3" width="76" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Monto (RD$)]]></text>
            </staticText>
            <staticText>
                <reportElement x="323" y="3" width="76" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Pendiente]]></text>
            </staticText>
            <staticText>
                <reportElement x="401" y="3" width="51" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Cant.]]></text>
            </staticText>
            <staticText>
                <reportElement x="454" y="3" width="114" height="14" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16" splitType="Stretch">
            <textField isBlankWhenNull="true">
                <reportElement x="4" y="2" width="151" height="11" style="Row"/>
                <textElement>
                    <font fontName="Arial" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{proveedor}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="157" y="2" width="86" height="11" style="Row"/>
                <textElement>
                    <font fontName="Arial" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="245" y="2" width="76" height="11" style="Row"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.00">
                <reportElement x="323" y="2" width="76" height="11" style="Row"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{monto_pendiente}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="401" y="2" width="51" height="11" style="Row"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="454" y="2" width="114" height="11" style="Row"/>
                <textElement textAlignment="Center">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="15" width="572" height="1"
                               forecolor="#CCCCCC" positionType="FixRelativeToBottom"/>
                <graphicElement>
                    <pen lineWidth="0.3"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <columnFooter>
        <band height="6" splitType="Stretch">
            <line>
                <reportElement x="0" y="4" width="572" height="1" forecolor="#004AAD"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
        </band>
    </columnFooter>

    <pageFooter>
        <band height="22" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="0" width="572" height="20"
                               forecolor="#004AAD" backcolor="#004AAD" mode="Opaque"/>
            </rectangle>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="4" y="2" width="160" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="166" y="2" width="240" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Arial" size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[DOMINO'S PIZZA — Sistema de Gestión]]></text>
            </staticText>
            <textField>
                <reportElement x="408" y="2" width="80" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="490" y="2" width="78" height="16" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Arial" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="28" splitType="Stretch">
            <rectangle>
                <reportElement x="0" y="4" width="572" height="20"
                               forecolor="#E8F0FB" backcolor="#E8F0FB" mode="Opaque"/>
            </rectangle>
            <staticText>
                <reportElement x="4" y="8" width="150" height="12" forecolor="#004AAD"/>
                <textElement>
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total de compras registradas:]]></text>
            </staticText>
            <textField>
                <reportElement x="156" y="8" width="40" height="12" forecolor="#BE1E1E"/>
                <textElement>
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalCompras}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="350" y="8" width="110" height="12" forecolor="#004AAD"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Total gastado (RD$):]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="462" y="8" width="106" height="12" forecolor="#BE1E1E"/>
                <textElement textAlignment="Right">
                    <font fontName="Arial" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{sumaMontos}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
